
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "backend/src/**/*.ts",
    "shared/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "web",
    "**/node_modules"
  ]
}
