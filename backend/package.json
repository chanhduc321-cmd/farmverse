{
  "name": "happyfarm-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "migrate": "node --env-file=.env --import tsx src/migrate.ts",
    "seed:friends": "node --env-file=.env --import tsx src/seed-friends.ts",
    "db:check": "node --env-file=.env --import tsx src/check-database.ts",
    "near:setup": "node --env-file=.env --import tsx src/blockchain/near-setup.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "bs58": "6.0.0",
    "hono": "^4.13.17",
    "jose": "6.2.17",
    "near-api-js": "7.5.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
