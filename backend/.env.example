# Local PostgreSQL via Docker Compose. Backend scripts load .env.
POSTGRES_PASSWORD=farmverse_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://farmverse:farmverse_local@127.0.0.1:5432/farmverse
PORT=8092
# For Vercel, set DATABASE_URL in project environment settings.
# Use the database provider's pooled URL and its TLS connection settings.
# NEAR Auth testnet. Set the exact callback URL allowed on the Auth0 client.
# For the shared testnet client, use http://localhost:3000/ and start the web app with PORT=3000.
# NEAR_AUTH_CALLBACK_URL=https://your-demo.example/api/account/social/near/callback
# NEAR_AUTH_CLIENT_ID=your-approved-testnet-public-client-id
# Optional local test-signature route. Use the testnet demo sponsor key on the backend only.
# NEAR_TEST_SIGNING_SPONSOR_KEY=
# USDC testnet adapter; server-only keys. Account IDs and token contract are pinned to testnet.
# NEAR_USDC_ENABLED=true
# NEAR_USDC_NPC_KEY=
# Demo roles for pnpm trade-demo:setup. Use farm IDs from verified Google identities.
# TRADE_DEMO_SELLER_FARM_ID=
# TRADE_DEMO_BUYER_FARM_ID=
