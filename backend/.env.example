# Local PostgreSQL via Docker Compose. Backend scripts load .env.
POSTGRES_PASSWORD=farmverse_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://farmverse:farmverse_local@127.0.0.1:5432/farmverse
PORT=8092
# For Vercel, set DATABASE_URL in project environment settings.
# Use the database provider's pooled URL and its TLS connection settings.
